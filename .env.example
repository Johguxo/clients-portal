# Supabase — copia este archivo a .env.local y rellena los valores.
#
# LOCAL (supabase start): usa los valores que imprime la CLI.
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key de `supabase start`>
#
# CLOUD: Project Settings → API en el dashboard de Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo backend (server-side). NUNCA exponer con prefijo NEXT_PUBLIC.
# Se usa en el seed para crear los usuarios de demo.
SUPABASE_SERVICE_ROLE_KEY=
